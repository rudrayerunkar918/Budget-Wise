# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FINNHUB_API_KEY: Required for Finnhub real-time stock market data & quotes.
# Free API key can be obtained from https://finnhub.io/
# Configured via the Secrets panel in the AI Studio UI or in-app Settings screen.
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY

# ALPHA_VANTAGE_API_KEY: Required for Alpha Vantage live stock quotes & company overview.
# Free API key can be obtained from https://www.alphavantage.co/support/#api-key
# Configured via the Secrets panel in the AI Studio UI or in-app Settings screen.
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY
